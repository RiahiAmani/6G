# ---- Étape 1 : compilation (cette image est jetée à la fin) ----
FROM ubuntu:22.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
ARG JOBS=1
RUN apt-get update && apt-get install -y --no-install-recommends git make gcc g++ cmake \
      libsctp-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/aligungr/UERANSIM /ueransim \
 && cd /ueransim && make -j${JOBS}

# ---- Étape 2 : image finale, uniquement ce qui sert à l'exécution ----
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends libsctp1 iproute2 iputils-ping iperf3 curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /ueransim/build /ueransim/build
COPY --from=build /ueransim/config /ueransim/config
WORKDIR /ueransim
