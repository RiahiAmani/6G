    serving2.append(cur)
ho1 = int(((serving != np.roll(serving, 1)) & cov & np.roll(cov, 1))[1:].sum())
ho2 = sum(1 for a, b in zip(serving2[:-1], serving2[1:]) if a is not None and b is not None and a != b)
print("Handovers 'plus proche' :", ho1, "| 'garder tant que visible' :", ho2)
print("Délai moyen stratégie 2 (ms) :", np.nanmean([dist[s, k] / C * 1000 for k, s in enumerate(serving2) if s is not None]).round(2))
